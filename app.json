{
  "expo": {
    "name": "Sarani",
    "slug": "serein",
    "scheme": "sarani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon-light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shreyas.sarani",
      "icon": {
        "light": "./assets/icons/app-icon-light.png",
        "dark": "./assets/icons/app-icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon-light.png",
        "backgroundColor": "#FAF8F5"
      },
      "package": "com.shreyas.sarani"
    },
    "web": {
      "favicon": "./assets/icons/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/app-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5",
          "dark": {
            "image": "./assets/icons/app-icon-dark.png",
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Sarani",
              "label": "Sarani",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "description": "Shows your One Thing for today.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c71c750c-b0a1-4b4b-beb5-77fae3f62c8b"
      }
    },
    "owner": "shreyasice"
  }
}
