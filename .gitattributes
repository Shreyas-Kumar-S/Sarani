# Normalize line endings: store text as LF in the repo, regardless of the
# contributor's OS. Prevents the whole-file CRLF diffs Prettier flags on Windows.
* text=auto eol=lf

# Binary assets — never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
